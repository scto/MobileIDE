                }
            },
            {
                "scope": "constant.character",
                "settings": {
                    "foreground": "#BD41BB"
                }
            },
            {
                "scope": "constant.language",
                "settings": {
                    "foreground": "#DC952E"
                }
            },
            {
                "scope": "entity.name",
                "settings": {
                    "foreground": "#56A6E0"
                }
            },
            {
                "scope": "invalid",
                "settings": {
                    "foreground": "#B24021"
                }
            },
            {
                "scope": "keyword, storage, variable.language",
                "settings": {
                    "foreground": "#E29539"
                }
            },
            {
                "scope": "variable, entity.name.section",
