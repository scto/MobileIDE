            "error": "#F2392B",
            "onError": "#bbbbbb",
            "outline": "#43413F",
            "outlineVariant": "#4B4B4B"
        },
        "editorColors": {
            "problem_typo": "#D7B86A",
            "problem_warning": "#D19045",
            "problem_error": "#F2392B",
            "sticky_scroll_divider": "#2D2D2D",
