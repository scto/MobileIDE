{
    "$schema": "https:\/\/raw.githubusercontent.com\/Xed-Editor\/Theme-Template\/refs\/heads\/main\/schema\/schema.json",
    "id": "io.kiquar.theme.feslake",
    "name": "Feslake",
    "minAppVersion": 95,
    "inheritBase": false,
    "author": {
        "displayName": "KiquarSL",
        "github": "KiquarSL"
    },
    "version": "0.1.0",
    "repository": "https://github.com/KiquarSL/xed-feslake",
    "light": {
        "baseColors": {
            "background": "#FFFFFF",
            "onBackground": "#1A1A1A",
            "surface": "#F5F5F5",
            "onSurface": "#1A1A1A",
            "surfaceVariant": "#E8E8E8",
            "onSurfaceVariant": "#1A1A1A",
            "surfaceContainer": "#E8E8E8",
            "primary": "#D97D2D",
            "onPrimary": "#FFFFFF",
            "primaryContainer": "#F5E6D3",
            "onPrimaryContainer": "#4A2A10",
            "secondary": "#D97D2D",
            "onSecondary": "#FFFFFF",
            "secondaryContainer": "#F5E6D3",
            "onSecondaryContainer": "#4A2A10",
            "error": "#F2392B",
            "onError": "#FFFFFF",
            "outline": "#BDBDBD",
            "outlineVariant": "#9E9E9E"
        },
        "editorColors": {
            "problem_typo": "#B8A06A",
            "problem_warning": "#C08030",
            "problem_error": "#D03020",
            "sticky_scroll_divider": "#D0D0D0",
            "strikethrough": "#888888",
            "diagnostic_tooltip_action": "#333333",
            "diagnostic_tooltip_detailed_msg": "#333333",
            "diagnostic_tooltip_brief_msg": "#333333",
            "diagnostic_tooltip_background": "#F0F0F0",
            "function_char_background_stroke": "#AAAAAA",
            "hard_wrap_marker": "#AAAAAA",
            "text_inlay_hint_foreground": "#444444",
            "text_inlay_hint_background": "#F0F0F0",
            "snippet_background_editing": "#F0F0F0",
            "snippet_background_related": "#F0F0F0",
            "snippet_background_inactive": "#C0C0C0",
            "side_block_line": "#D0D0D0",
            "non_printable_char": "#D0D0D0",
            "text_selected": "#333333",
            "matched_text_background": "#E0E0E0",
            "matched_text_border": "#C0C0C0",
            "completion_wnd_corner": "#B0B0B0",
            "completion_wnd_background": "#F0F0F0",
            "completion_wnd_text_matched": "#555555",
            "completion_wnd_text_primary": "#333333",
            "completion_wnd_text_secondary": "#666666",
            "completion_wnd_item_current": "#D0D0D0",
            "text_highlight_strong_background": "#E0E0E0",
            "text_highlight_strong_border": "#C0C0C0",
            "text_highlight_background": "#E8E8E8",
            "text_highlight_border": "#C8C8C8",
            "highlighted_delimiters_underline": "#C0C0C0",
            "line_number_panel_text": "#666666",
            "line_number_panel": "#F5F5F5",
            "block_line_current": "#E8E8E8",
            "block_line": "#F0F0F0",
            "scroll_bar_track": "#D0D0D0",
            "scroll_bar_thumb_pressed": "#B0B0B0",
            "current_line": "#F0F0F0",
            "current_row_border": "#E0E0E0",
            "selection_handle": "#B0B0B0",
            "selection_insert": "#333333",
            "selected_text_background": "#D0D0D0",
            "selected_text_border": "#B0B0B0",
            "text_normal": "#1A1A1A",
            "whole_background": "#FFFFFF",
            "line_number_current": "#B05C13",
            "line_divider": "#E0E0E0"
        },
        "tokenColors": [
            {
                "scope": "comment",
                "settings": {
                    "foreground": "#616161",
                    "style": "italic"
                }
            },
            {
                "scope": "string, comment.line.documentation, comment.block.documentation",
                "settings": {
                    "foreground": "#46B451"
                }
            },
            {
                "scope": "constant.numeric",
                "settings": {
                    "foreground": "#54D044"
                }
            },
            {
                "scope": "constant.character",
                "settings": {
                    "foreground": "#BD41BB"
                }
            },
            {
                "scope": "constant.language",
                "settings": {
                    "foreground": "#DC952E"
                }
            },
            {
                "scope": "entity.name",
                "settings": {
                    "foreground": "#56A6E0"
                }
            },
            {
                "scope": "invalid",
                "settings": {
                    "foreground": "#B24021"
                }
            },
            {
                "scope": "keyword, storage, variable.language",
                "settings": {
                    "foreground": "#E29539"
                }
            },
            {
                "scope": "variable, entity.name.section",
                "settings": {
                    "foreground": "#C87CBD"
                }
            }
        ]
    },
    "dark": {
        "baseColors": {
            "background": "#1D1D1D",
            "onBackground": "#bbbbbb",
            "surface": "#1D1D1D",
            "onSurface": "#bbbbbb",
            "surfaceVariant": "#2D2D2D",
